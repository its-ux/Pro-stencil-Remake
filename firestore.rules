rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net default-deny gate
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isHardcodedAdmin() {
      return isAuthenticated() && 
             (('email' in request.auth.token && (request.auth.token.email == "kenny.goossens@gmail.com" || request.auth.token.email == "kenny.acinked@gmail.com")));
    }

    function isAdmin() {
      return isAuthenticated() && 
             (isHardcodedAdmin() || 
              (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
               (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user') == 'admin' ||
                get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('email', '') == "kenny.goossens@gmail.com" ||
                get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('email', '') == "kenny.acinked@gmail.com")));
    }

    function isValidEmail(email) {
      return email == null || (email is string && (email == '' || (email.size() >= 3 && email.size() <= 254)));
    }

    function isValidUser(data) {
      return ('email' in data ? isValidEmail(data.email) : true);
    }

    function isValidStencil(data, userId) {
      return data.keys().hasAll(['userId', 'originalImage', 'stencilImage', 'styleName', 'date']) &&
             data.userId == userId &&
             data.originalImage is string && data.originalImage.size() < 10000000 &&
             data.stencilImage is string && data.stencilImage.size() < 10000000 &&
             data.styleName is string && data.styleName.size() < 100;
    }

    function isValidGalleryItem(data, uid) {
      return data.keys().hasAll(['uid', 'stencilImage', 'originalImage', 'styleName', 'createdAt', 'publishedAt']) &&
             data.uid == uid &&
             data.stencilImage is string && data.stencilImage.size() < 10000000 &&
             data.originalImage is string && data.originalImage.size() < 10000000 &&
             data.styleName is string && data.styleName.size() < 100;
    }

    // ===============================================================
    // Rules Matching Paths
    // ===============================================================

    match /gallery/{galleryId} {
      allow read: if true;
      allow create: if isOwner(request.resource.data.uid) && isValidGalleryItem(request.resource.data, request.resource.data.uid);
      allow update: if isAdmin() || (isOwner(resource.data.uid) && isOwner(request.resource.data.uid) && isValidGalleryItem(request.resource.data, request.resource.data.uid));
      allow delete: if isAdmin() || isOwner(resource.data.uid);
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isHardcodedAdmin() || isAdmin();
      
      // Allow user creation by owner (self-heal or initial registration) or by admin
      allow create: if (isOwner(userId) && request.resource.data.uid == userId && isValidUser(request.resource.data)) || isAdmin();
                    
      // Restrict critical fields during self update unless admin
      allow update: if isAdmin() || (isOwner(userId) && 
                                     !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'quota', 'status']));
      allow delete: if isAdmin();
      
      match /stencils/{stencilId} {
        allow get: if isOwner(userId) || isAdmin();
        allow list: if isOwner(userId) || isHardcodedAdmin() || isAdmin();
        
        allow create: if (isOwner(userId) || isAdmin()) && isValidStencil(request.resource.data, userId);
        allow update: if (isOwner(userId) || isAdmin()) && isValidStencil(request.resource.data, userId);
        allow delete: if isOwner(userId) || isAdmin();
      }
    }

    match /site/content {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /feedback/{feedbackId} {
      allow get: if isAdmin();
      allow list: if isHardcodedAdmin() || isAdmin();
      allow create: if request.resource.data.keys().hasAll(['userId', 'userEmail', 'content', 'type', 'timestamp', 'userAgent']) &&
                    request.resource.data.userId is string && request.resource.data.userId.size() <= 128 &&
                    request.resource.data.userEmail is string && request.resource.data.userEmail.size() <= 128 &&
                    request.resource.data.content is string && request.resource.data.content.size() <= 5000 &&
                    request.resource.data.type in ['bug', 'suggestion', 'other'] &&
                    request.resource.data.timestamp == request.time &&
                    request.resource.data.userAgent is string && request.resource.data.userAgent.size() <= 1024 &&
                    request.resource.data.keys().hasOnly(['userId', 'userEmail', 'content', 'type', 'timestamp', 'userAgent']);
      allow update, delete: if isAdmin();
    }

    match /logs/{logId} {
      allow get: if isAdmin();
      allow list: if isHardcodedAdmin() || isAdmin();
      // Enforce strict un-spoofable parameters on creations
      allow create: if request.resource.data.keys().hasAll(['event', 'category', 'metadata', 'ip', 'userAgent', 'timestamp', 'user', 'userId']) &&
                    request.resource.data.event is string && request.resource.data.event.size() <= 100 &&
                    request.resource.data.category is string && request.resource.data.category.size() <= 100 &&
                    request.resource.data.metadata is map &&
                    request.resource.data.ip is string && request.resource.data.ip.size() <= 45 &&
                    request.resource.data.userAgent is string && request.resource.data.userAgent.size() <= 1024 &&
                    request.resource.data.timestamp == request.time &&
                    request.resource.data.user is string && request.resource.data.user.size() <= 128 &&
                    request.resource.data.userId is string && request.resource.data.userId.size() <= 128 &&
                    (!isAuthenticated() ? request.resource.data.userId == 'anonymous' : request.resource.data.userId == request.auth.uid) &&
                    (!isAuthenticated() ? request.resource.data.user == 'anonymous' : request.resource.data.user is string) &&
                    request.resource.data.keys().hasOnly(['event', 'category', 'metadata', 'ip', 'userAgent', 'timestamp', 'user', 'userId']);
      allow update, delete: if isAdmin();
    }

    match /messages/{messageId} {
      allow get: if isAdmin();
      allow list: if isHardcodedAdmin() || isAdmin();
      // Verify sender credentials directly in rules to block message spoofing/spamming
      allow create: if isAuthenticated() &&
                    request.resource.data.keys().hasAll(['userId', 'userEmail', 'userName', 'message', 'createdAt', 'read']) &&
                    request.resource.data.userId == request.auth.uid &&
                    request.resource.data.userEmail == request.auth.token.email &&
                    (request.resource.data.userName == null || (request.resource.data.userName is string && request.resource.data.userName.size() <= 128)) &&
                    request.resource.data.message is string && request.resource.data.message.size() <= 10000 &&
                    request.resource.data.createdAt == request.time &&
                    request.resource.data.read == false &&
                    request.resource.data.keys().hasOnly(['userId', 'userEmail', 'userName', 'message', 'createdAt', 'read']);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
